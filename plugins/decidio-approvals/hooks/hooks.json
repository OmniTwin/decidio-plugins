{
  "description": "Decidio approvals. Every hook runs `node ${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs <event>` in exec form: the launcher checks the project folder, then runs the pinned release's `npx -y @decidio/sdk@<release> hook <event>` from the home folder (so a project's node_modules or .npmrc never chooses the code), naming the project in DECIDIO_HOOK_CWD, passing stdin, stdout and the exit code through (on Windows too, with no shell of ours) - except `notice`, which the launcher answers itself, without npx (after an MCP call Decidio's hook doesn't read, a one-time line for the person, once per server per session; about 40 ms, never blocks). Before every Bash/PowerShell/Monitor call and selected MCP tool call, the pretool hook asks Decidio whether the command needs a person's approval (only destructive commands do - `npx @decidio/sdk hook rules`); after it runs, the posttool hook records the execution, which spends that approval. The same pair guards Claude Code's own settings: a Write, Edit or MultiEdit on .claude/settings*.json, ~/.claude/settings*.json or the Decidio plugin's files is asked about when it would remove or change Decidio's hooks, turn hooks or the plugin off, or leave the file invalid (the `if` filters keep ordinary edits from starting the hook). At session start - and after /clear and a compaction - the session hook tells the person in one line that approvals are on and who approves, and, when the person is signed in to Decidio on this computer (`npx @decidio/sdk login`), hands Claude their Decidio context (what the connector's get_company_context answers: their units, their context packs and the always-on decisions), read with their own sign-in in the same 1.5 seconds; and, on a connected computer, reports this install's version, a SHA-256 of its code and how it is installed (nothing of the person's) so Decidio can tell the workspace owner when a locked computer's lock is removed or its code is edited - best effort; signed out or unanswered, nothing more (it never blocks). The person's own typed `decidio pause` / `decidio start` pauses or resumes the guard for that session (the prompt hook, behind the launcher's pre-filter: the SDK starts only for a prompt that mentions Decidio; not where the workspace keeps the guard on - Enterprise by default; every pause is recorded in the workspace's audit log, and the Agents page shows it while it holds). Needs this computer connected to Decidio - the first destructive command shows a link the workspace owner allows, once for every project on the computer (or `npx @decidio/sdk connect`, or an `init` .env). The pretool hook BLOCKS the call if it fails (onFailure) - a gate that cannot answer never answers yes.",
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash|PowerShell|Monitor", "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs", "pretool"], "timeout": 150, "onFailure": "block"}]},
      {"matcher":"^mcp__.+__(?:(?:[^_-]+[_-])*|.*[a-z])(?:(?:[Dd]elete|DELETE|[Dd]rop|DROP|[Dd]estroy|DESTROY|[Pp]urge|PURGE|[Tt]erminate|TERMINATE|[Tt]runcate|TRUNCATE|[Ww]ipe|WIPE|[Rr]eset|RESET|[Ff]lush|FLUSH|[Rr]emove|REMOVE|[Pp]rune|PRUNE|[Uu]npublish|UNPUBLISH|[Yy]ank|YANK|[Dd]eprecate|DEPRECATE|[Aa]rchive|ARCHIVE|[Rr]ollback|ROLLBACK|[Pp]ublish|PUBLISH|[Ss]ql|SQL|[Ee]xecute|EXECUTE|[Ee]xec|EXEC|[Ss]tatement|STATEMENT|[Mm]igration|MIGRATION|[Mm]igrate|MIGRATE|[Ss]hell|SHELL|[Tt]erminal|TERMINAL|[Bb]ash|BASH|[Cc]ommand|COMMAND|[Cc]md|CMD|[Ss]pawn|SPAWN)|(?:[Ff]orce|FORCE)[_-]?(?:[Pp]ush|PUSH)|(?:[Cc]reate|CREATE)[_-]?(?:[Rr]elease|RELEASE)|(?:[Ww]rite|WRITE|[Ee]dit|EDIT|[Mm]ove|MOVE|[Rr]ename|RENAME|[Cc]opy|COPY|[Ss]ave|SAVE|[Pp]ut|PUT|[Cc]reate|CREATE|[Uu]pdate|UPDATE|[Aa]ppend|APPEND)[_-]?(?:[Ff]ile|FILE)|(?:[Ww]rite|WRITE|[Ee]dit|EDIT|[Mm]ove|MOVE|[Rr]ename|RENAME|[Cc]opy|COPY|[Ss]ave|SAVE|[Pp]ut|PUT|[Cc]reate|CREATE|[Uu]pdate|UPDATE|[Aa]ppend|APPEND)[_-]?(?:[Tt]ext|TEXT)[_-]?(?:[Ff]ile|FILE)|(?:[Ee]dit|EDIT)[_-]?(?:[Bb]lock|BLOCK)|(?:[Ss]tart|START)[_-]?(?:[Pp]rocess|PROCESS)|(?:[Rr]un|RUN)[_-]?(?:[Cc]ommand|COMMAND|[Ss]cript|SCRIPT))","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs","pretool"],"timeout":150,"onFailure":"block"}]},
      {"matcher": "Write", "hooks": [{"type": "command", "if": "Write(**/.claude/settings*.json)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs", "pretool"], "timeout": 150, "onFailure": "block"}]},
      {"matcher": "Write", "hooks": [{"type": "command", "if": "Write(~/.claude/settings*.json)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs", "pretool"], "timeout": 150, "onFailure": "block"}]},
      {"matcher": "Write", "hooks": [{"type": "command", "if": "Write(~/.claude/plugins/**)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs", "pretool"], "timeout": 150, "onFailure": "block"}]},
      {"matcher": "Edit", "hooks": [{"type": "command", "if": "Edit(**/.claude/settings*.json)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs", "pretool"], "timeout": 150, "onFailure": "block"}]},
      {"matcher": "Edit", "hooks": [{"type": "command", "if": "Edit(~/.claude/settings*.json)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs", "pretool"], "timeout": 150, "onFailure": "block"}]},
      {"matcher": "Edit", "hooks": [{"type": "command", "if": "Edit(~/.claude/plugins/**)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs", "pretool"], "timeout": 150, "onFailure": "block"}]},
      {"matcher": "MultiEdit", "hooks": [{"type": "command", "if": "MultiEdit(**/.claude/settings*.json)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs", "pretool"], "timeout": 150, "onFailure": "block"}]},
      {"matcher": "MultiEdit", "hooks": [{"type": "command", "if": "MultiEdit(~/.claude/settings*.json)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs", "pretool"], "timeout": 150, "onFailure": "block"}]},
      {"matcher": "MultiEdit", "hooks": [{"type": "command", "if": "MultiEdit(~/.claude/plugins/**)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs", "pretool"], "timeout": 150, "onFailure": "block"}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash|PowerShell|Monitor", "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs", "posttool"], "timeout": 30}]},
      {"matcher":"^mcp__.+__(?:(?:[^_-]+[_-])*|.*[a-z])(?:(?:[Dd]elete|DELETE|[Dd]rop|DROP|[Dd]estroy|DESTROY|[Pp]urge|PURGE|[Tt]erminate|TERMINATE|[Tt]runcate|TRUNCATE|[Ww]ipe|WIPE|[Rr]eset|RESET|[Ff]lush|FLUSH|[Rr]emove|REMOVE|[Pp]rune|PRUNE|[Uu]npublish|UNPUBLISH|[Yy]ank|YANK|[Dd]eprecate|DEPRECATE|[Aa]rchive|ARCHIVE|[Rr]ollback|ROLLBACK|[Pp]ublish|PUBLISH|[Ss]ql|SQL|[Ee]xecute|EXECUTE|[Ee]xec|EXEC|[Ss]tatement|STATEMENT|[Mm]igration|MIGRATION|[Mm]igrate|MIGRATE|[Ss]hell|SHELL|[Tt]erminal|TERMINAL|[Bb]ash|BASH|[Cc]ommand|COMMAND|[Cc]md|CMD|[Ss]pawn|SPAWN)|(?:[Ff]orce|FORCE)[_-]?(?:[Pp]ush|PUSH)|(?:[Cc]reate|CREATE)[_-]?(?:[Rr]elease|RELEASE)|(?:[Ww]rite|WRITE|[Ee]dit|EDIT|[Mm]ove|MOVE|[Rr]ename|RENAME|[Cc]opy|COPY|[Ss]ave|SAVE|[Pp]ut|PUT|[Cc]reate|CREATE|[Uu]pdate|UPDATE|[Aa]ppend|APPEND)[_-]?(?:[Ff]ile|FILE)|(?:[Ww]rite|WRITE|[Ee]dit|EDIT|[Mm]ove|MOVE|[Rr]ename|RENAME|[Cc]opy|COPY|[Ss]ave|SAVE|[Pp]ut|PUT|[Cc]reate|CREATE|[Uu]pdate|UPDATE|[Aa]ppend|APPEND)[_-]?(?:[Tt]ext|TEXT)[_-]?(?:[Ff]ile|FILE)|(?:[Ee]dit|EDIT)[_-]?(?:[Bb]lock|BLOCK)|(?:[Ss]tart|START)[_-]?(?:[Pp]rocess|PROCESS)|(?:[Rr]un|RUN)[_-]?(?:[Cc]ommand|COMMAND|[Ss]cript|SCRIPT))","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/decidio-hook.mjs","posttool"],"timeout":30}]},
